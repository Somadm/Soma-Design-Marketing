{%- doc -%}
  Asturan brand layer: brand colour tokens, brand fonts and the shared Asturan stylesheet and script.
  Rendered in the <head> after Horizon's own variables so these values win.
{%- enddoc -%}

{%- if settings.asturan_use_brand_fonts -%}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  {%- if settings.asturan_font_pairing == 'classic' -%}
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Jost:wght@300;400;500;600&display=swap"
    >
  {%- else -%}
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Noto+Sans:wght@400;500;600;700&family=Noto+Serif:ital,wght@0,400;0,500;1,400&display=swap"
    >
  {%- endif -%}
{%- endif -%}

{% style %}
  :root {
    --asturan-burgundy: {{ settings.asturan_color_primary | default: '#7E252A' }};
    --asturan-burgundy-rgb: {{ settings.asturan_color_primary.red | default: 126 }} {{ settings.asturan_color_primary.green | default: 37 }} {{ settings.asturan_color_primary.blue | default: 42 }};
    --asturan-gold: {{ settings.asturan_color_accent | default: '#D0A248' }};
    --asturan-black: #000000;
    --asturan-white: #ffffff;
    --asturan-gutter: 16px;
    --asturan-tap: 44px;
    --asturan-logo-height: {{ settings.asturan_logo_height | default: 140 }}px;
    --asturan-logo-height-mobile: {{ settings.asturan_logo_height_mobile | default: 64 }}px;

    {%- if settings.asturan_use_brand_fonts %}
      {%- if settings.asturan_font_pairing == 'classic' %}
        --asturan-font-heading: 'Cormorant Garamond', 'Cormorant', Georgia, 'Times New Roman', serif;
        --asturan-font-body: 'Jost', 'Helvetica Neue', Arial, sans-serif;
      {%- else %}
        --asturan-font-heading: 'Noto Serif', Georgia, 'Times New Roman', serif;
        --asturan-font-body: 'Noto Sans', 'Helvetica Neue', Arial, sans-serif;
      {%- endif %}
      --font-heading--family: var(--asturan-font-heading);
      --font-heading--style: normal;
      --font-heading--weight: 400;
      --font-accent--family: var(--asturan-font-heading);
      --font-accent--style: normal;
      --font-accent--weight: 400;
      --font-body--family: var(--asturan-font-body);
      --font-body--style: normal;
      --font-body--weight: 400;
      --font-subheading--family: var(--asturan-font-body);
      --font-subheading--style: normal;
      --font-subheading--weight: 500;
    {%- else %}
      --asturan-font-heading: var(--font-heading--family);
      --asturan-font-body: var(--font-body--family);
    {%- endif %}
  }

  @media screen and (min-width: 750px) {
    :root {
      --asturan-gutter: 32px;
    }
  }
{% endstyle %}

{{ 'asturan.css' | asset_url | stylesheet_tag }}
<script src="{{ 'asturan.js' | asset_url }}" type="module" fetchpriority="low"></script>

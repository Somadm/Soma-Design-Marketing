{%- comment -%}
  Asturan footer (burgundy): email sign-up, Shop and Help menus, contact email, Instagram and TikTok.
{%- endcomment -%}

{%- liquid
  assign contact_email = section.settings.contact_email | default: shop.email
  assign social_handle = section.settings.social_handle
-%}

<div class="asturan-footer">
  <div class="asturan-container">
    <div class="asturan-footer__top">
      <div class="asturan-footer__signup">
        <h2 class="asturan-footer__heading">{{ section.settings.signup_heading | escape }}</h2>
        {%- if section.settings.signup_text != blank -%}
          <div class="asturan-footer__text">{{ section.settings.signup_text }}</div>
        {%- endif -%}

        {%- form 'customer', id: 'AsturanFooterSignup', class: 'asturan-signup' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          {%- if form.posted_successfully? -%}
            <p class="asturan-signup__message" role="status">{{ section.settings.signup_success | escape }}</p>
          {%- else -%}
            <div class="asturan-signup__row">
              <label class="visually-hidden" for="AsturanFooterSignupEmail">{{ section.settings.signup_placeholder | escape }}</label>
              <input
                id="AsturanFooterSignupEmail"
                class="asturan-signup__input"
                type="email"
                name="contact[email]"
                autocomplete="email"
                autocorrect="off"
                autocapitalize="off"
                placeholder="{{ section.settings.signup_placeholder | escape }}"
                required
                {% if form.errors %}
                  aria-invalid="true" aria-describedby="AsturanFooterSignupError"
                {% endif %}
              >
              <button class="asturan-btn asturan-btn--white" type="submit">
                {{- section.settings.signup_button | escape -}}
              </button>
            </div>
            {%- if form.errors -%}
              <p id="AsturanFooterSignupError" class="asturan-signup__message" role="alert">
                {{ form.errors.translated_fields.email | capitalize }}
                {{ form.errors.messages.email }}
              </p>
            {%- endif -%}
          {%- endif -%}
        {%- endform -%}
      </div>

      <nav class="asturan-footer__menus" aria-label="{{ section.settings.shop_heading | escape }}">
        {%- assign menus = 'shop,help' | split: ',' -%}
        {%- for key in menus -%}
          {%- liquid
            assign menu_setting = key | append: '_menu'
            assign heading_setting = key | append: '_heading'
            assign menu = section.settings[menu_setting]
          -%}
          {%- if menu != blank and menu.links.size > 0 -%}
            <div class="asturan-footer__menu">
              <h3 class="asturan-footer__menu-title">{{ section.settings[heading_setting] | escape }}</h3>
              <ul class="list-unstyled" role="list">
                {%- for link in menu.links -%}
                  <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}
        {%- endfor -%}

        <div class="asturan-footer__menu">
          <h3 class="asturan-footer__menu-title">{{ section.settings.contact_heading | escape }}</h3>
          <ul class="list-unstyled" role="list">
            {%- if contact_email != blank -%}
              <li><a href="mailto:{{ contact_email }}">{{ contact_email }}</a></li>
            {%- endif -%}
          </ul>
          <ul class="asturan-social list-unstyled" role="list">
            {%- if section.settings.instagram_url != blank -%}
              <li>
                <a href="{{ section.settings.instagram_url }}" target="_blank" rel="noopener" aria-label="Instagram {{ social_handle | escape }}">
                  <svg aria-hidden="true" focusable="false" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.4" cy="6.6" r="1" fill="currentColor" stroke="none"/></svg>
                </a>
              </li>
            {%- endif -%}
            {%- if section.settings.tiktok_url != blank -%}
              <li>
                <a href="{{ section.settings.tiktok_url }}" target="_blank" rel="noopener" aria-label="TikTok {{ social_handle | escape }}">
                  <svg aria-hidden="true" focusable="false" width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M16.6 3c.3 2.3 1.6 3.8 3.9 4v2.7c-1.4.1-2.6-.3-3.9-1.1v5.9c0 6.8-7.4 9-10.4 4.1-1.9-3.1-.7-8.6 5.5-8.8v2.9c-.5.1-1 .2-1.4.3-1.4.5-2.2 1.4-2 3 .4 3 6 3.9 5.5-2V3h2.8z"/></svg>
                </a>
              </li>
            {%- endif -%}
            {%- if social_handle != blank -%}
              <li class="asturan-social__handle">{{ social_handle | escape }}</li>
            {%- endif -%}
          </ul>
        </div>
      </nav>
    </div>

    <div class="asturan-footer__bottom">
      <p class="asturan-footer__copyright">
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name | link_to: routes.root_url }}
      </p>
      {%- if shop.policies.size > 0 -%}
        <ul class="asturan-footer__policies list-unstyled" role="list">
          {%- for policy in shop.policies -%}
            <li><a href="{{ policy.url }}">{{ policy.title | escape }}</a></li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
      {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
        <ul class="asturan-footer__payments list-unstyled" role="list">
          {%- for type in shop.enabled_payment_types -%}
            <li>{{ type | payment_type_svg_tag: class: 'asturan-footer__payment-icon' }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Asturan footer",
  "class": "asturan-footer-section",
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    { "type": "header", "content": "Email sign-up" },
    { "type": "text", "id": "signup_heading", "label": "Heading", "default": "Join our email list" },
    { "type": "richtext", "id": "signup_text", "label": "Text" },
    { "type": "text", "id": "signup_placeholder", "label": "Email field placeholder", "default": "Email address" },
    { "type": "text", "id": "signup_button", "label": "Button label", "default": "Sign up" },
    { "type": "text", "id": "signup_success", "label": "Success message", "default": "Thank you for joining." },
    { "type": "header", "content": "Menus" },
    { "type": "text", "id": "shop_heading", "label": "First menu heading", "default": "Shop" },
    { "type": "link_list", "id": "shop_menu", "label": "First menu" },
    { "type": "text", "id": "help_heading", "label": "Second menu heading", "default": "Help" },
    { "type": "link_list", "id": "help_menu", "label": "Second menu", "default": "footer" },
    { "type": "header", "content": "Contact and social" },
    { "type": "text", "id": "contact_heading", "label": "Contact heading", "default": "Contact" },
    { "type": "text", "id": "contact_email", "label": "Contact email", "info": "Leave empty to use the store's email." },
    { "type": "url", "id": "instagram_url", "label": "Instagram link" },
    { "type": "url", "id": "tiktok_url", "label": "TikTok link" },
    { "type": "text", "id": "social_handle", "label": "Social handle", "default": "@shop.asturan" },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Show payment icons", "default": true }
  ],
  "presets": [{ "name": "Asturan footer" }]
}
{% endschema %}

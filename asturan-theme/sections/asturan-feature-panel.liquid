{%- comment -%}
  Asturan feature panel: two photos on warm white next to a solid burgundy or black panel with a small
  heading, a large serif title, text, a gold caption and a button. Photos fall back to the first products
  of the chosen collection.
{%- endcomment -%}

{%- liquid
  assign collection = section.settings.collection
  assign button_url = section.settings.button_url | default: collection.url | default: routes.all_products_collection_url
-%}

<section class="asturan-feature asturan-feature--{{ section.settings.panel_color }}{% if section.settings.panel_position == 'left' %} asturan-feature--panel-left{% endif %}">
  <div class="asturan-feature__media">
    {%- for i in (1..2) -%}
      {%- liquid
        assign key = 'image_' | append: i
        assign img = section.settings[key]
        if img == blank and collection != blank
          assign product_index = i | minus: 1
          assign img = collection.products[product_index].featured_media.preview_image
        endif
      -%}
      <div class="asturan-rect asturan-feature__image">
        {%- if img != blank -%}
          {{
            img
            | image_url: width: 1000
            | image_tag: widths: '400, 600, 800, 1000', sizes: '(min-width: 990px) 30vw, 50vw', loading: 'lazy'
          }}
        {%- else -%}
          {{ 'product-apparel-3' | placeholder_svg_tag: 'asturan-placeholder' }}
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>

  <div class="asturan-feature__panel">
    {%- if section.settings.eyebrow != blank -%}
      <p class="asturan-eyebrow asturan-eyebrow--gold">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="asturan-feature__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <div class="asturan-feature__text">{{ section.settings.text }}</div>
    {%- endif -%}
    {%- if section.settings.caption != blank -%}
      <p class="asturan-feature__caption">{{ section.settings.caption | escape }}</p>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a class="asturan-btn asturan-btn--white" href="{{ button_url }}">{{ section.settings.button_label | escape }}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Asturan feature panel",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "image_picker", "id": "image_1", "label": "First photo", "info": "Leave empty to use the collection's first product." },
    { "type": "image_picker", "id": "image_2", "label": "Second photo", "info": "Leave empty to use the collection's second product." },
    {
      "type": "select",
      "id": "panel_color",
      "label": "Panel colour",
      "options": [
        { "value": "burgundy", "label": "Burgundy" },
        { "value": "black", "label": "Black" }
      ],
      "default": "burgundy"
    },
    {
      "type": "select",
      "id": "panel_position",
      "label": "Panel position on desktop",
      "options": [
        { "value": "right", "label": "Right" },
        { "value": "left", "label": "Left" }
      ],
      "default": "right"
    },
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "Collection focus" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Metallic Satin Abayas" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "caption", "label": "Gold caption" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop now" },
    { "type": "url", "id": "button_url", "label": "Button link", "info": "Leave empty to link to the collection." }
  ],
  "presets": [{ "name": "Asturan feature panel" }]
}
{% endschema %}

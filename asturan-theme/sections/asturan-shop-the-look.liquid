{%- comment -%}
  Asturan "Shop the look": a burgundy block with a large photo, the product name, price, colours, sizes
  and a white "Shop now" button. If no photo is chosen, the product's own photos are used, so the block
  never shows a placeholder or logo image. Add more "Look" blocks to show several looks.
{%- endcomment -%}

{%- liquid
  assign colour_names = settings.asturan_color_option_names | default: 'Color,Colour' | downcase | split: ','
-%}

<section class="asturan-looks">
  {%- for block in section.blocks -%}
    {%- liquid
      assign product = block.settings.product
      if product == blank and block.settings.title_keyword != blank
        assign keyword = block.settings.title_keyword | downcase
        for candidate in collections.all.products
          assign candidate_title = candidate.title | downcase
          if candidate.available and candidate_title contains keyword
            assign product = candidate
            break
          endif
        endfor
      endif
      if product == blank
        assign product = block.settings.fallback_collection.products.first | default: collections.all.products.first
      endif
      assign look_image = block.settings.image | default: product.featured_media.preview_image
      assign colour_option = nil
      assign size_option = nil
      for option in product.options_with_values
        assign option_name = option.name | downcase | strip
        assign is_colour = false
        for name in colour_names
          assign clean_name = name | strip
          if option_name == clean_name
            assign is_colour = true
          endif
        endfor
        if is_colour and colour_option == nil
          assign colour_option = option
        elsif size_option == nil and option_name contains 'size'
          assign size_option = option
        endif
      endfor
      assign button_url = block.settings.button_url | default: product.url | default: routes.all_products_collection_url
    -%}
    <div
      class="asturan-look{% if block.settings.image_position == 'right' %} asturan-look--image-right{% endif %}"
      {{ block.shopify_attributes }}
    >
      <div class="asturan-look__media">
        {%- liquid
          assign look_image_mobile = block.settings.image_mobile | default: look_image
        -%}
        {%- if look_image != blank -%}
          <picture class="asturan-look__frame">
            {%- if block.settings.image_mobile != blank -%}
              <source
                media="(max-width: 989px)"
                srcset="{{ look_image_mobile | image_url: width: 750 }} 750w, {{ look_image_mobile | image_url: width: 1200 }} 1200w"
                sizes="100vw"
              >
            {%- endif -%}
            {{
              look_image
              | image_url: width: 1600
              | image_tag:
                widths: '600, 900, 1200, 1600',
                sizes: '(min-width: 990px) 58vw, 100vw',
                loading: 'lazy',
                alt: product.title
            }}
          </picture>
        {%- else -%}
          <div class="asturan-look__frame">{{ 'product-apparel-2' | placeholder_svg_tag: 'asturan-placeholder' }}</div>
        {%- endif -%}
        {%- liquid
          assign second_image = block.settings.image_2
          if second_image == blank and block.settings.image == blank
            assign second_image = product.media[1].preview_image
          endif
        -%}
        {%- if second_image != blank -%}
          <div class="asturan-look__frame asturan-look__frame--second">
            {{
              second_image
              | image_url: width: 1000
              | image_tag: widths: '400, 600, 800, 1000', sizes: '(min-width: 990px) 28vw, 50vw', loading: 'lazy', alt: ''
            }}
          </div>
        {%- endif -%}
      </div>

      <div class="asturan-look__content">
        {%- if block.settings.eyebrow != blank -%}
          <p class="asturan-look__eyebrow">{{ block.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <h2 class="asturan-look__title">{{ product.title | default: 'Choose a product' | escape }}</h2>
        {%- if product != blank -%}
          {%- liquid
            assign meta = product.price | money
            if colour_option
              assign colour_list = ''
              for value in colour_option.values
                assign colour_list = colour_list | append: value
                unless forloop.last
                  assign colour_list = colour_list | append: ', '
                endunless
              endfor
              assign meta = meta | append: ' · ' | append: colour_list
            endif
            if size_option
              assign first_size = size_option.values.first
              assign last_size = size_option.values.last
              if size_option.values.size > 1
                assign meta = meta | append: ' · ' | append: block.settings.sizes_word | append: ' ' | append: first_size | append: '–' | append: last_size
              else
                assign meta = meta | append: ' · ' | append: first_size
              endif
            endif
          -%}
          <p class="asturan-look__meta">
            {{ meta | escape }}
            {%- if product.compare_at_price > product.price %}
              <s>{{ product.compare_at_price | money }}</s>
            {%- endif -%}
          </p>
        {%- endif -%}

        {%- if block.settings.button_label != blank -%}
          <a class="asturan-btn asturan-btn--white" href="{{ button_url }}">
            {{- block.settings.button_label | escape -}}
          </a>
        {%- endif -%}
      </div>
    </div>
  {%- endfor -%}
</section>

{% schema %}
{
  "name": "Asturan shop the look",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "look",
      "name": "Look",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        {
          "type": "text",
          "id": "title_keyword",
          "label": "If no product is chosen, use a product whose name contains",
          "default": "Metallic Satin"
        },
        { "type": "collection", "id": "fallback_collection", "label": "Otherwise use the first product of" },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo",
          "info": "Leave empty to use the product's main photo."
        },
        { "type": "image_picker", "id": "image_2", "label": "Second photo (optional)", "info": "Leave both photos empty to show the product's first two photos." },
        { "type": "image_picker", "id": "image_mobile", "label": "Mobile photo (optional)" },
        { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "Shop the look" },
        { "type": "text", "id": "sizes_word", "label": "Word before the size range", "default": "Sizes" },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop now" },
        { "type": "url", "id": "button_url", "label": "Button link", "info": "Leave empty to link to the product." },
        {
          "type": "select",
          "id": "image_position",
          "label": "Photo position on desktop",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "right", "label": "Right" }
          ],
          "default": "left"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Asturan shop the look",
      "blocks": [{ "type": "look" }]
    }
  ]
}
{% endschema %}

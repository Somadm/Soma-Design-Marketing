{%- comment -%}
  Asturan "Shop the look": a burgundy block with a large photo, the product name, price, colours, sizes
  and a white "Shop now" button. If no photo is chosen, the product's own photos are used, so the block
  never shows a placeholder or logo image. Add more "Look" blocks to show several looks.
{%- endcomment -%}

{%- liquid
  assign colour_names = settings.asturan_color_option_names | default: 'Color,Colour' | downcase | split: ','
-%}

<section class="asturan-section asturan-looks">
  {%- for block in section.blocks -%}
    {%- liquid
      assign product = block.settings.product
      assign look_image = block.settings.image | default: product.featured_media.preview_image
      assign colour_option = nil
      assign size_option = nil
      for option in product.options_with_values
        assign option_name = option.name | downcase | strip
        assign is_colour = false
        for name in colour_names
          assign clean_name = name | strip
          if option_name == clean_name
            assign is_colour = true
          endif
        endfor
        if is_colour and colour_option == nil
          assign colour_option = option
        elsif size_option == nil and option_name contains 'size'
          assign size_option = option
        endif
      endfor
      assign button_url = block.settings.button_url | default: product.url | default: routes.all_products_collection_url
    -%}
    <div
      class="asturan-look{% if block.settings.image_position == 'right' %} asturan-look--image-right{% endif %}"
      {{ block.shopify_attributes }}
    >
      <div class="asturan-look__media">
        <div class="asturan-arch asturan-look__frame">
          {%- if look_image != blank -%}
            {{
              look_image
              | image_url: width: 1600
              | image_tag:
                widths: '450, 750, 1000, 1300, 1600',
                sizes: '(min-width: 990px) 50vw, 100vw',
                loading: 'lazy',
                alt: product.title
            }}
          {%- else -%}
            {{ 'product-apparel-2' | placeholder_svg_tag: 'asturan-placeholder' }}
          {%- endif -%}
        </div>
      </div>

      <div class="asturan-look__content">
        {%- if block.settings.eyebrow != blank -%}
          <p class="asturan-look__eyebrow">{{ block.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <h2 class="asturan-look__title">{{ product.title | default: 'Choose a product' | escape }}</h2>
        {%- if product != blank -%}
          <p class="asturan-look__price">
            {%- if product.compare_at_price > product.price -%}
              {{ product.price | money }} <s>{{ product.compare_at_price | money }}</s>
            {%- else -%}
              {{ product.price | money }}
            {%- endif -%}
          </p>
        {%- endif -%}

        {%- if colour_option -%}
          <div class="asturan-look__row">
            <span class="asturan-look__label">{{ colour_option.name | escape }}</span>
            <span class="asturan-look__values">
              {%- for value in colour_option.values -%}
                {{ value | escape }}
                {%- unless forloop.last %} · {% endunless -%}
              {%- endfor -%}
            </span>
          </div>
        {%- endif -%}
        {%- if size_option -%}
          <div class="asturan-look__row">
            <span class="asturan-look__label">{{ size_option.name | escape }}</span>
            <ul class="asturan-look__sizes list-unstyled" role="list">
              {%- for value in size_option.values -%}
                <li>{{ value | escape }}</li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}

        {%- if block.settings.button_label != blank -%}
          <a class="asturan-btn asturan-btn--white" href="{{ button_url }}">
            {{- block.settings.button_label | escape -}}
          </a>
        {%- endif -%}
      </div>
    </div>
  {%- endfor -%}
</section>

{% schema %}
{
  "name": "Asturan shop the look",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "look",
      "name": "Look",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo",
          "info": "Leave empty to use the product's main photo."
        },
        { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "Shop the look" },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop now" },
        { "type": "url", "id": "button_url", "label": "Button link", "info": "Leave empty to link to the product." },
        {
          "type": "select",
          "id": "image_position",
          "label": "Photo position on desktop",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "right", "label": "Right" }
          ],
          "default": "left"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Asturan shop the look",
      "blocks": [{ "type": "look" }]
    }
  ]
}
{% endschema %}

{%- comment -%}
  Asturan editorial hero: fashion-magazine layout on a light background. Oversized serif headline, small
  label and text, arrow-style shopping links, and two overlapping photos over soft brand-coloured shapes.
  Add Panel blocks to make it slide: the panels glide sideways every few seconds with a layered parallax
  movement and rewind to the first after the last, with previous, next and pause controls. Without Panel
  blocks the section shows one panel from the settings below. Motion is off for reduced-motion visitors.
{%- endcomment -%}

{%- liquid
  assign panel_count = section.blocks.size
  if panel_count == 0
    assign panel_count = 1
  endif
-%}

<section
  class="asturan-ed asturan-ed--bg-{{ section.settings.background }}{% if section.settings.animate %} asturan-ed--animate{% endif %}{% if panel_count > 1 %} asturan-ed--slider{% endif %}"
  {% if panel_count > 1 %}
    role="region"
    aria-roledescription="carousel"
    aria-label="{{ section.settings.slider_label | escape }}"
    data-asturan-ed-slider
    data-interval="{{ section.settings.autoplay_seconds | times: 1000 }}"
    data-autoplay="{{ section.settings.autoplay }}"
  {% else %}
    aria-labelledby="AsturanEdHeading-{{ section.id }}-0"
  {% endif %}
>
  <div class="asturan-ed__viewport">
    <div class="asturan-ed__track" data-ed-track>
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- assign heading_id = 'AsturanEdHeading-' | append: section.id | append: '-' | append: forloop.index0 -%}
          {% render 'asturan-ed-panel',
            s: block.settings,
            index: forloop.index0,
            count: panel_count,
            id: heading_id,
            attributes: block.shopify_attributes
          %}
        {%- endfor -%}
      {%- else -%}
        {%- assign heading_id = 'AsturanEdHeading-' | append: section.id | append: '-0' -%}
        {% render 'asturan-ed-panel', s: section.settings, index: 0, count: 1, id: heading_id %}
      {%- endif -%}
    </div>
  </div>

  {%- if panel_count > 1 -%}
    <div class="asturan-ed__controls">
      <p class="asturan-ed__counter" aria-hidden="true">
        <span data-ed-current>01</span>
        <span class="asturan-ed__counter-line"><span data-ed-progress></span></span>
        <span>{% if panel_count < 10 %}0{% endif %}{{ panel_count }}</span>
      </p>
      <div class="asturan-ed__buttons">
        <button type="button" class="asturan-ed__btn" data-ed-prev aria-label="{{ section.settings.prev_label | escape }}">
          <svg aria-hidden="true" focusable="false" width="34" height="12" viewBox="0 0 34 12" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M34 6H2M7 1 2 6l5 5"/></svg>
        </button>
        <button type="button" class="asturan-ed__btn" data-ed-next aria-label="{{ section.settings.next_label | escape }}">
          <svg aria-hidden="true" focusable="false" width="34" height="12" viewBox="0 0 34 12" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M0 6h32M27 1l5 5-5 5"/></svg>
        </button>
        <button
          type="button"
          class="asturan-ed__btn asturan-ed__btn--pause"
          data-ed-pause
          aria-pressed="false"
          aria-label="{{ section.settings.pause_label | escape }}"
          data-label-pause="{{ section.settings.pause_label | escape }}"
          data-label-play="{{ section.settings.play_label | escape }}"
        >
          <svg class="asturan-ed__icon-pause" aria-hidden="true" focusable="false" width="12" height="12" viewBox="0 0 12 12" fill="currentColor"><rect x="2" y="1" width="2.6" height="10"/><rect x="7.4" y="1" width="2.6" height="10"/></svg>
          <svg class="asturan-ed__icon-play" aria-hidden="true" focusable="false" width="12" height="12" viewBox="0 0 12 12" fill="currentColor"><path d="M3 1.5v9l7.5-4.5z"/></svg>
        </button>
      </div>
      <p class="visually-hidden" aria-live="polite" data-ed-live></p>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Asturan editorial hero",
  "settings": [
    { "type": "text", "id": "label", "label": "Small label", "default": "ASTURAN MODEST" },
    { "type": "text", "id": "heading_1", "label": "Headline, first line", "default": "Modest style." },
    {
      "type": "text",
      "id": "heading_2",
      "label": "Headline, second line",
      "info": "Shown in italic burgundy.",
      "default": "Beautifully yours."
    },
    {
      "type": "text",
      "id": "text",
      "label": "Supporting text",
      "default": "Discover hijabs and abayas for everyday elegance."
    },
    { "type": "header", "content": "Shopping links" },
    { "type": "text", "id": "link_1_label", "label": "First link label", "default": "SHOP HIJABS" },
    { "type": "collection", "id": "link_1_collection", "label": "First link collection" },
    { "type": "url", "id": "link_1_url", "label": "First link (overrides collection)" },
    { "type": "text", "id": "link_2_label", "label": "Second link label", "default": "SHOP ABAYAS" },
    { "type": "collection", "id": "link_2_collection", "label": "Second link collection" },
    { "type": "url", "id": "link_2_url", "label": "Second link (overrides collection)" },
    { "type": "header", "content": "Photos" },
    {
      "type": "image_picker",
      "id": "image_main",
      "label": "Large model portrait",
      "info": "Tall portrait, about 2:3. Leave empty to use the included Asturan photo."
    },
    {
      "type": "image_picker",
      "id": "image_second",
      "label": "Smaller lifestyle or product photo",
      "info": "About 3:4. Leave empty to use the included Asturan photo."
    },
    { "type": "text", "id": "caption", "label": "Small caption by the photos", "default": "New season · Abayas & hijabs" },
    { "type": "header", "content": "Sliding" },
    {
      "type": "paragraph",
      "content": "Add Panel blocks to make the hero slide. Each panel has its own text, links and photos."
    },
    { "type": "checkbox", "id": "autoplay", "label": "Slide automatically", "default": true },
    {
      "type": "range",
      "id": "autoplay_seconds",
      "label": "Time on each panel",
      "min": 3,
      "max": 12,
      "step": 1,
      "unit": "s",
      "default": 5
    },
    { "type": "text", "id": "slider_label", "label": "Slider accessible name", "default": "Asturan highlights" },
    { "type": "text", "id": "prev_label", "label": "Previous button label", "default": "Previous" },
    { "type": "text", "id": "next_label", "label": "Next button label", "default": "Next" },
    { "type": "text", "id": "pause_label", "label": "Pause button label", "default": "Pause" },
    { "type": "text", "id": "play_label", "label": "Play button label", "default": "Play" },
    { "type": "header", "content": "Style" },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "white", "label": "White" },
        { "value": "cream", "label": "Warm white" }
      ],
      "default": "white"
    },
    { "type": "checkbox", "id": "show_shapes", "label": "Soft shapes behind the photos", "default": true },
    {
      "type": "checkbox",
      "id": "animate",
      "label": "Gentle entrance animation",
      "info": "Always off for visitors who prefer reduced motion.",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "panel",
      "name": "Panel",
      "settings": [
        { "type": "text", "id": "label", "label": "Small label", "default": "ASTURAN MODEST" },
        { "type": "text", "id": "heading_1", "label": "Headline, first line", "default": "Modest style." },
        { "type": "text", "id": "heading_2", "label": "Headline, second line", "info": "Shown in italic burgundy.", "default": "Beautifully yours." },
        { "type": "text", "id": "text", "label": "Supporting text" },
        { "type": "text", "id": "link_1_label", "label": "First link label", "default": "SHOP HIJABS" },
        { "type": "collection", "id": "link_1_collection", "label": "First link collection" },
        { "type": "url", "id": "link_1_url", "label": "First link (overrides collection)" },
        { "type": "text", "id": "link_2_label", "label": "Second link label", "default": "SHOP ABAYAS" },
        { "type": "collection", "id": "link_2_collection", "label": "Second link collection" },
        { "type": "url", "id": "link_2_url", "label": "Second link (overrides collection)" },
        {
          "type": "select",
          "id": "layout",
          "label": "Photos on the",
          "options": [
            { "value": "right", "label": "Right" },
            { "value": "left", "label": "Left" }
          ],
          "default": "right"
        },
        { "type": "image_picker", "id": "image_main", "label": "Large photo" },
        {
          "type": "select",
          "id": "fallback_main",
          "label": "Included large photo",
          "info": "Used when no large photo is chosen.",
          "options": [
            { "value": "asturan-hero-portrait.jpg", "label": "Grey hijab portrait" },
            { "value": "asturan-hero-lifestyle.jpg", "label": "Black marble abaya" },
            { "value": "asturan-popup.jpg", "label": "Brown metallic abaya" },
            { "value": "asturan-hero-purple.jpg", "label": "Purple metallic abaya" },
            { "value": "asturan-hero-embroidered.jpg", "label": "Embroidered closed abaya" },
            { "value": "asturan-hero-prayer.jpg", "label": "Pink prayer set" },
            { "value": "asturan-hijab-1.jpg", "label": "Polka dot hijab" },
            { "value": "asturan-hijab-2.jpg", "label": "Wave print hijab" },
            { "value": "asturan-hijab-3.jpg", "label": "Floral modal hijab" }
          ],
          "default": "asturan-hero-portrait.jpg"
        },
        { "type": "image_picker", "id": "image_second", "label": "Smaller photo" },
        {
          "type": "select",
          "id": "fallback_second",
          "label": "Included smaller photo",
          "info": "Used when no smaller photo is chosen.",
          "options": [
            { "value": "asturan-hero-portrait.jpg", "label": "Grey hijab portrait" },
            { "value": "asturan-hero-lifestyle.jpg", "label": "Black marble abaya" },
            { "value": "asturan-popup.jpg", "label": "Brown metallic abaya" },
            { "value": "asturan-hero-purple.jpg", "label": "Purple metallic abaya" },
            { "value": "asturan-hero-embroidered.jpg", "label": "Embroidered closed abaya" },
            { "value": "asturan-hero-prayer.jpg", "label": "Pink prayer set" },
            { "value": "asturan-hijab-1.jpg", "label": "Polka dot hijab" },
            { "value": "asturan-hijab-2.jpg", "label": "Wave print hijab" },
            { "value": "asturan-hijab-3.jpg", "label": "Floral modal hijab" }
          ],
          "default": "asturan-hero-lifestyle.jpg"
        },
        { "type": "text", "id": "caption", "label": "Small caption by the photos" }
      ]
    }
  ],
  "presets": [{ "name": "Asturan editorial hero" }]
}
{% endschema %}

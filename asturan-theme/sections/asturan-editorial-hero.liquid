{%- comment -%}
  Asturan editorial hero: fashion-magazine layout on a light background. Oversized serif headline, small
  label and text, arrow-style shopping links, and two overlapping photos (a large model portrait and a
  smaller lifestyle or product photo) over soft brand-coloured shapes. Gentle entrance animation that
  switches off for visitors who prefer reduced motion. Photos fall back to Asturan photos included in
  the theme until others are chosen.
{%- endcomment -%}

{%- liquid
  assign link_1_url = section.settings.link_1_url | default: section.settings.link_1_collection.url | default: routes.all_products_collection_url
  assign link_2_url = section.settings.link_2_url | default: section.settings.link_2_collection.url | default: routes.all_products_collection_url
  assign main_image = section.settings.image_main
  assign second_image = section.settings.image_second
-%}

<section
  class="asturan-ed asturan-ed--bg-{{ section.settings.background }}{% if section.settings.animate %} asturan-ed--animate{% endif %}"
  aria-labelledby="AsturanEdHeading-{{ section.id }}"
>
  <div class="asturan-ed__inner">
    <div class="asturan-ed__text">
      {%- if section.settings.label != blank -%}
        <p class="asturan-ed__label" style="--d: 0.05s;">{{ section.settings.label | escape }}</p>
      {%- endif -%}
      <h1 id="AsturanEdHeading-{{ section.id }}" class="asturan-ed__heading">
        <span class="asturan-ed__line" style="--d: 0.15s;">{{ section.settings.heading_1 | escape }}</span>
        {%- if section.settings.heading_2 != blank -%}
          <span class="asturan-ed__line asturan-ed__line--accent" style="--d: 0.3s;">
            {{- section.settings.heading_2 | escape -}}
          </span>
        {%- endif -%}
      </h1>
      {%- if section.settings.text != blank -%}
        <p class="asturan-ed__copy" style="--d: 0.45s;">{{ section.settings.text | escape }}</p>
      {%- endif -%}
      <div class="asturan-ed__links" style="--d: 0.55s;">
        {%- if section.settings.link_1_label != blank -%}
          <a class="asturan-ed__link" href="{{ link_1_url }}">
            <span>{{ section.settings.link_1_label | escape }}</span>
            <svg aria-hidden="true" focusable="false" width="34" height="12" viewBox="0 0 34 12" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M0 6h32M27 1l5 5-5 5"/></svg>
          </a>
        {%- endif -%}
        {%- if section.settings.link_2_label != blank -%}
          <a class="asturan-ed__link" href="{{ link_2_url }}">
            <span>{{ section.settings.link_2_label | escape }}</span>
            <svg aria-hidden="true" focusable="false" width="34" height="12" viewBox="0 0 34 12" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M0 6h32M27 1l5 5-5 5"/></svg>
          </a>
        {%- endif -%}
      </div>
    </div>

    <div class="asturan-ed__media">
      {%- if section.settings.show_shapes -%}
        <span class="asturan-ed__shape asturan-ed__shape--circle" aria-hidden="true"></span>
        <span class="asturan-ed__shape asturan-ed__shape--arch" aria-hidden="true"></span>
      {%- endif -%}

      <a class="asturan-ed__photo asturan-ed__photo--main" href="{{ link_1_url }}" tabindex="-1" aria-hidden="true" style="--d: 0.2s;">
        {%- if main_image != blank -%}
          {{
            main_image
            | image_url: width: 1400
            | image_tag:
              widths: '480, 700, 900, 1100, 1400',
              sizes: '(min-width: 990px) 34vw, 72vw',
              loading: 'eager',
              fetchpriority: 'high',
              alt: ''
          }}
        {%- else -%}
          <img
            src="{{ 'asturan-hero-portrait.jpg' | asset_url }}"
            alt=""
            width="710"
            height="1080"
            loading="eager"
            fetchpriority="high"
          >
        {%- endif -%}
      </a>

      <a class="asturan-ed__photo asturan-ed__photo--second" href="{{ link_2_url }}" tabindex="-1" aria-hidden="true" style="--d: 0.45s;">
        {%- if second_image != blank -%}
          {{
            second_image
            | image_url: width: 900
            | image_tag: widths: '320, 480, 700, 900', sizes: '(min-width: 990px) 20vw, 46vw', loading: 'eager', alt: ''
          }}
        {%- else -%}
          <img src="{{ 'asturan-hero-lifestyle.jpg' | asset_url }}" alt="" width="732" height="977" loading="eager">
        {%- endif -%}
      </a>

      {%- if section.settings.caption != blank -%}
        <p class="asturan-ed__caption" style="--d: 0.65s;">{{ section.settings.caption | escape }}</p>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Asturan editorial hero",
  "settings": [
    { "type": "text", "id": "label", "label": "Small label", "default": "ASTURAN MODEST" },
    { "type": "text", "id": "heading_1", "label": "Headline, first line", "default": "Modest style." },
    {
      "type": "text",
      "id": "heading_2",
      "label": "Headline, second line",
      "info": "Shown in italic burgundy.",
      "default": "Beautifully yours."
    },
    {
      "type": "text",
      "id": "text",
      "label": "Supporting text",
      "default": "Discover hijabs and abayas for everyday elegance."
    },
    { "type": "header", "content": "Shopping links" },
    { "type": "text", "id": "link_1_label", "label": "First link label", "default": "SHOP HIJABS" },
    { "type": "collection", "id": "link_1_collection", "label": "First link collection" },
    { "type": "url", "id": "link_1_url", "label": "First link (overrides collection)" },
    { "type": "text", "id": "link_2_label", "label": "Second link label", "default": "SHOP ABAYAS" },
    { "type": "collection", "id": "link_2_collection", "label": "Second link collection" },
    { "type": "url", "id": "link_2_url", "label": "Second link (overrides collection)" },
    { "type": "header", "content": "Photos" },
    {
      "type": "image_picker",
      "id": "image_main",
      "label": "Large model portrait",
      "info": "Tall portrait, about 2:3. Leave empty to use the included Asturan photo."
    },
    {
      "type": "image_picker",
      "id": "image_second",
      "label": "Smaller lifestyle or product photo",
      "info": "About 3:4. Leave empty to use the included Asturan photo."
    },
    { "type": "text", "id": "caption", "label": "Small caption by the photos", "default": "New season · Abayas & hijabs" },
    { "type": "header", "content": "Style" },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "white", "label": "White" },
        { "value": "cream", "label": "Warm white" }
      ],
      "default": "white"
    },
    { "type": "checkbox", "id": "show_shapes", "label": "Soft shapes behind the photos", "default": true },
    {
      "type": "checkbox",
      "id": "animate",
      "label": "Gentle entrance animation",
      "info": "Always off for visitors who prefer reduced motion.",
      "default": true
    }
  ],
  "presets": [{ "name": "Asturan editorial hero" }]
}
{% endschema %}

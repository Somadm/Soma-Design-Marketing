{%- doc -%}
  Small burgundy category label above the product name (for example "Abayas · Open").
  Uses the text below if set; otherwise the product's most specific collection, then its product type.
{%- enddoc -%}

{%- liquid
  assign product = closest.product
  if request.visual_preview_mode and product == blank
    assign product = collections.all.products.first
  endif
  assign label = block.settings.text
  if label == blank
    assign skip_handles = block.settings.skip_handles | remove: ' ' | split: ','
    for c in product.collections
      unless skip_handles contains c.handle
        assign label = c.title
        break
      endunless
    endfor
  endif
  if label == blank
    assign label = product.type
  endif
-%}

{%- if label != blank -%}
  <p class="asturan-label asturan-pdp-label" {{ block.shopify_attributes }}>{{ label | escape }}</p>
{%- endif -%}

{% schema %}
{
  "name": "Asturan category label",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Label",
      "info": "Leave empty to use the product's collection (for example Open Abayas)."
    },
    {
      "type": "text",
      "id": "skip_handles",
      "label": "Collections to skip",
      "default": "all,frontpage,new-trending,sale,abayas,hijabs",
      "info": "Broad collection handles that are never used as the label, comma-separated."
    }
  ],
  "presets": [
    {
      "name": "Asturan category label",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}

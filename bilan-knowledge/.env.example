# --- Required ---
DATABASE_URL=postgres://user:password@host:5432/bilan
# Dashboard + API access token (min 16 chars). Bilan's backend sends it as "Authorization: Bearer <token>".
ADMIN_TOKEN=change-me-to-a-long-random-string
# Research (Claude API: analysis, web search, web fetch). Without it the service only serves saved knowledge.
ANTHROPIC_API_KEY=

# --- Process ---
PORT=8080
# all = API + dashboard + scheduler in one process; or run "web" and "worker" separately.
PROCESS_ROLE=all

# --- Schedule ---
KB_SCHEDULE_ENABLED=true
# Run the initial research automatically on first start.
KB_AUTO_INITIAL=true
# Days between refreshes, measured from the last SUCCESSFUL refresh.
REFRESH_INTERVAL_DAYS=42
SCHEDULER_TICK_SECONDS=300
# Automatic retries after a failed/incomplete refresh (hours; list length = max retries).
REFRESH_RETRY_DELAYS_HOURS=1,6,24
RUN_STALE_MINUTES=20

# --- Fetching ---
FETCH_MAX_ATTEMPTS=3
FETCH_TIMEOUT_MS=30000
DISCONTINUE_AFTER_MISSES=2
MAX_PAGE_CHARS=150000
USE_CLAUDE_WEB_FETCH_FALLBACK=true

# --- Research model ---
RESEARCH_MODEL=claude-opus-5-5
RESEARCH_EFFORT=medium
BRIEFING_EFFORT=high

# --- Spending limits (USD at Anthropic list prices) ---
MAX_USD_PER_REFRESH=20
MAX_USD_PER_MONTH=50
MAX_USD_PER_QUESTION=1
MAX_SOURCES_PER_REFRESH=150
MAX_DISCOVERY_SEARCHES_PER_PLATFORM=8
MAX_NEW_SOURCES_PER_REFRESH=40

# --- Live checks between refreshes ---
LIVE_CHECK_FRESH_HOURS=24
LIVE_CHECK_MAX_SOURCES=3

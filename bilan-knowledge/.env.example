# ---- Required ----
DATABASE_URL=postgres://user:password@host:5432/postgres
# Dashboard login and the token Bilan's chat backend sends as "Authorization: Bearer <token>" (min 16 chars).
ADMIN_TOKEN=change-me-to-a-long-random-string
# Set to "production" on the deployed backend. Only a production worker can mark
# "First scheduled refresh completed" and "Failure path tested".
DEPLOYMENT_ENV=development
# Research service: Claude API (extraction, comparison, discovery via web search, briefings).
ANTHROPIC_API_KEY=
RESEARCH_MODEL=claude-sonnet-5-5

# ---- Optional services ----
# Hybrid search (pgvector + Voyage embeddings). Without it, search is full-text only.
VOYAGE_API_KEY=
# Rendered fetch for JavaScript-rendered or bot-protected pages.
FIRECRAWL_API_KEY=
# Alert emails when a refresh fails or is incomplete (recipient is set in Settings).
RESEND_API_KEY=
ALERT_FROM_EMAIL=Bilan <alerts@yourdomain.com>
APP_URL=https://your-deployment.example.com

# ---- Process ----
PORT=8080
# all = API + UI + worker in one process; or run "web" and "worker" separately.
PROCESS_ROLE=all
WORKER_POLL_SECONDS=20
TICK_MINUTES=15

# Schedule, retries, run window, budgets, alert email and the Creative Academy profile
# are edited in the Settings tab (stored in the database), not here.

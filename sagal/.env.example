# Copy to .env for local development (never commit .env).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sagal_dev
# 32 random bytes, base64. Generate with: npm run gen-key   (back it up: it decrypts your saved API keys)
SECRETS_MASTER_KEY=
OWNER_EMAIL=you@example.com
APP_URL=http://localhost:8080

# Storage: "local" for development. In production use "s3" (Supabase Storage, Cloudflare R2 or AWS S3).
STORAGE_DRIVER=local
# S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
# S3_REGION=<your Supabase region, e.g. eu-north-1>
# S3_BUCKET=sagal-media
# S3_VOICEOVER_BUCKET=sagal-voiceovers   (optional; otherwise voiceovers/ inside S3_BUCKET)
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Optional: these can instead be pasted in the app (Memory & settings → Connected accounts).
# ANTHROPIC_API_KEY=
# RESEND_API_KEY=
# EMAIL_FROM=Sagal <sagal@yourdomain.com>
# SAGAL_MODEL=claude-opus-5-5
# SAGAL_EFFORT=medium
